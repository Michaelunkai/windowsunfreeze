<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Thaw</RootNamespace>
    <AssemblyName>Thaw</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.4.5</Version>
    <Product>Thaw</Product>
    <AssemblyTitle>Thaw — Instant Unfreezer</AssemblyTitle>
    <Description>Breaks system freezes and restores full performance without closing a single app.</Description>
    <ApplicationIcon>Assets\Thaw.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Thaw.ico" />
  </ItemGroup>

</Project>
